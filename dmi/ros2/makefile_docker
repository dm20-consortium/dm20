IMAGE_PREFIX := dm2
IMAGE_TAG ?= 24.04

ifeq ($(IMAGE_TAG),22.04)
ROS_DISTRO := humble
else ifeq ($(IMAGE_TAG),24.04)
ROS_DISTRO := jazzy
else
$(error Unsupported IMAGE_TAG: $(IMAGE_TAG))
endif

DOCKER_BUILD := docker build
DOCKER_RMI := docker rmi -f

images:
	${DOCKER_BUILD} -f ./Dockerfile \
		--build-arg IMAGE_TAG=$(IMAGE_TAG) \
		--build-arg ROS_DISTRO=$(ROS_DISTRO) \
		-t ${IMAGE_PREFIX}/ros2dmi:${IMAGE_TAG} \
		.

clean:
	${DOCKER_RMI} ${IMAGE_PREFIX}/ros2dmi:${IMAGE_TAG}
