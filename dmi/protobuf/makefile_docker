IMAGE_PREFIX := dm2
IMAGE_TAG ?= 24.04
CPLUS_VER ?= c++17

DOCKER_BUILD := docker build
DOCKER_RMI := docker rmi -f

images:
	${DOCKER_BUILD} -f ./Dockerfile --build-arg IMAGE_TAG=$(IMAGE_TAG) --build-arg CPLUS_VER=$(CPLUS_VER) -t ${IMAGE_PREFIX}/protobufdmi:${IMAGE_TAG} .

clean:
	${DOCKER_RMI} ${IMAGE_PREFIX}/protobufdmi:${IMAGE_TAG}
