IMAGE_PREFIX := dm2
IMAGE_TAG ?= 24.04
CPLUS_VER ?= c++17

DOCKER_BUILD := docker build
DOCKER_RMI := docker rmi -f
PROTO_DOCKERFILE := proto/Dockerfile.proto.$(IMAGE_TAG)

images:
	${DOCKER_BUILD} -f base/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} -t ${IMAGE_PREFIX}/base:${IMAGE_TAG} base/
	${DOCKER_BUILD} -f secLib/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} -t ${IMAGE_PREFIX}/seclib:${IMAGE_TAG} secLib/
	${DOCKER_BUILD} -f csLib/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} -t ${IMAGE_PREFIX}/cslib:${IMAGE_TAG} csLib/
	${DOCKER_BUILD} -f commonLib/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} -t ${IMAGE_PREFIX}/commonlib:${IMAGE_TAG} commonLib/
	${DOCKER_BUILD} -f cs/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} -t ${IMAGE_PREFIX}/cs:${IMAGE_TAG} ./
	${DOCKER_BUILD} -f ${PROTO_DOCKERFILE} --build-arg IMAGE_TAG=${IMAGE_TAG} -t ${IMAGE_PREFIX}/protoc:${IMAGE_TAG} proto/
	${DOCKER_BUILD} -f proto/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} -t ${IMAGE_PREFIX}/proto:${IMAGE_TAG} proto/
	${DOCKER_BUILD} -f tupleLib/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} --build-arg CPLUS_VER=$(CPLUS_VER) -t ${IMAGE_PREFIX}/tuplelib:${IMAGE_TAG} ./
	${DOCKER_BUILD} -f dmClientLib/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} --build-arg CPLUS_VER=$(CPLUS_VER) -t ${IMAGE_PREFIX}/dmclientlib:${IMAGE_TAG} ./
	${DOCKER_BUILD} -f is/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} --build-arg CPLUS_VER=$(CPLUS_VER) -t ${IMAGE_PREFIX}/is:${IMAGE_TAG} ./
	${DOCKER_BUILD} -f apl/dm2mes/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} --build-arg CPLUS_VER=$(CPLUS_VER) -t ${IMAGE_PREFIX}/dm2mes:${IMAGE_TAG} ./
	${DOCKER_BUILD} -f rdb/Dockerfile -t ${IMAGE_PREFIX}/rdb:latest rdb/

without_dmi:
	${DOCKER_BUILD} -f base/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} -t ${IMAGE_PREFIX}/base:${IMAGE_TAG} base/
	${DOCKER_BUILD} -f secLib/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} -t ${IMAGE_PREFIX}/seclib:${IMAGE_TAG} secLib/
	${DOCKER_BUILD} -f csLib/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} -t ${IMAGE_PREFIX}/cslib:${IMAGE_TAG} csLib/
	${DOCKER_BUILD} -f commonLib/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} -t ${IMAGE_PREFIX}/commonlib:${IMAGE_TAG} commonLib/
	${DOCKER_BUILD} -f cs/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} -t ${IMAGE_PREFIX}/cs:${IMAGE_TAG} cs/
	${DOCKER_BUILD} -f ${PROTO_DOCKERFILE} --build-arg IMAGE_TAG=${IMAGE_TAG} -t ${IMAGE_PREFIX}/protoc:${IMAGE_TAG} proto/
	${DOCKER_BUILD} -f proto/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} -t ${IMAGE_PREFIX}/proto:${IMAGE_TAG} proto/
	${DOCKER_BUILD} -f tupleLib/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} --build-arg CPLUS_VER=$(CPLUS_VER) -t ${IMAGE_PREFIX}/tuplelib:${IMAGE_TAG} ./
	${DOCKER_BUILD} -f dmClientLib/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} --build-arg CPLUS_VER=$(CPLUS_VER) -t ${IMAGE_PREFIX}/dmclientlib:${IMAGE_TAG} ./
	${DOCKER_BUILD} -f is/Dockerfile_without_dmi --build-arg IMAGE_TAG=${IMAGE_TAG} --build-arg CPLUS_VER=$(CPLUS_VER) -t ${IMAGE_PREFIX}/is:${IMAGE_TAG} ./
	${DOCKER_BUILD} -f apl/dm2mes/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} --build-arg CPLUS_VER=$(CPLUS_VER) -t ${IMAGE_PREFIX}/dm2mes:${IMAGE_TAG} ./
	${DOCKER_BUILD} -f rdb/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} -t ${IMAGE_PREFIX}/rdb:${IMAGE_TAG} rdb/

libs:
	${DOCKER_BUILD} -f base/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} -t ${IMAGE_PREFIX}/base:${IMAGE_TAG} base/
	${DOCKER_BUILD} -f secLib/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} -t ${IMAGE_PREFIX}/seclib:${IMAGE_TAG} secLib/
	${DOCKER_BUILD} -f csLib/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} -t ${IMAGE_PREFIX}/cslib:${IMAGE_TAG} csLib/
	${DOCKER_BUILD} -f commonLib/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} -t ${IMAGE_PREFIX}/commonlib:${IMAGE_TAG} commonLib/
	${DOCKER_BUILD} -f ${PROTO_DOCKERFILE} --build-arg IMAGE_TAG=${IMAGE_TAG} -t ${IMAGE_PREFIX}/protoc:${IMAGE_TAG} proto/
	${DOCKER_BUILD} -f proto/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} -t ${IMAGE_PREFIX}/proto:${IMAGE_TAG} proto/
	${DOCKER_BUILD} -f tupleLib/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} --build-arg CPLUS_VER=$(CPLUS_VER) -t ${IMAGE_PREFIX}/tuplelib:${IMAGE_TAG} ./
	${DOCKER_BUILD} -f dmClientLib/Dockerfile --build-arg IMAGE_TAG=${IMAGE_TAG} --build-arg CPLUS_VER=$(CPLUS_VER) -t ${IMAGE_PREFIX}/dmclientlib:${IMAGE_TAG} ./

clean:
	${DOCKER_RMI} ${IMAGE_PREFIX}/dm2mes:${IMAGE_TAG}
	${DOCKER_RMI} ${IMAGE_PREFIX}/is:${IMAGE_TAG}
	${DOCKER_RMI} ${IMAGE_PREFIX}/proto:${IMAGE_TAG}
	${DOCKER_RMI} ${IMAGE_PREFIX}/dmclientlib:${IMAGE_TAG}
	${DOCKER_RMI} ${IMAGE_PREFIX}/tuplelib:${IMAGE_TAG}
	${DOCKER_RMI} ${IMAGE_PREFIX}/cs:${IMAGE_TAG}
	${DOCKER_RMI} ${IMAGE_PREFIX}/commonlib:${IMAGE_TAG}
	${DOCKER_RMI} ${IMAGE_PREFIX}/cslib:${IMAGE_TAG}
	${DOCKER_RMI} ${IMAGE_PREFIX}/base:${IMAGE_TAG}
